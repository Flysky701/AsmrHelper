{
  "$schema": "https://schema.tauri.app/config/2.11.2",
  "productName": "ASMR Helper Test",
  "version": "1.0.1",
  "identifier": "com.asmrhelper.desktop.test",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*.mp3",
          "**/*.wav",
          "**/*.flac",
          "**/*.ogg",
          "**/*.m4a",
          "**/*.aac",
          "**/*.wma"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "license": "CC-BY-NC-4.0",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/character/icon.png", "icons/character/icon.ico"],
    "targets": [
      "nsis"
    ],
    "resources": {
      "bundle-resources/backend/": "backend/",
      "../../LICENSE": "licenses/AsmrHelper-LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.md": "licenses/AsmrHelper-THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/character/icon.ico",
        "headerImage": "icons/character/installer-header.bmp",
        "sidebarImage": "icons/character/installer-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
